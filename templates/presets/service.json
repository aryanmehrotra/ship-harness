{
  "$schema": "https://raw.githubusercontent.com/aryanmehrotra/ship-harness/main/schema/ship.config.schema.json",
  "tracker": {
    "kind": "github"
  },
  "testPaths": [
    "**/*_test.go",
    "test/**",
    "tests/**"
  ],
  "attribution": false,
  "setup": {
    "confirmedAt": null
  },
  "autonomy": {
    "mode": "goal"
  },
  "caps": {
    "research": 3,
    "reviewDelta": 2,
    "spikes": 3,
    "planReviewA": 3,
    "planReviewB": 2,
    "reviewA": 3,
    "reviewB": 2,
    "evidenceFix": 2
  },
  "reviewers": {
    "correctness": "sonnet",
    "design": "opus"
  },
  "env": {
    "ready": "sbx ready ${SBX_SANDBOX:-$(basename $PWD)}",
    "readyTimeout": 120
  },
  "collectors": [
    {
      "name": "tests",
      "kind": "builtin:tests",
      "config": {
        "cmd": "go test ./..."
      }
    },
    {
      "name": "api",
      "kind": "builtin:http-pairs",
      "config": {
        "baseUrl": "http://localhost:8080",
        "requests": [
          {
            "name": "health",
            "method": "GET",
            "path": "/health"
          }
        ],
        "includeHeaders": [
          "content-type"
        ],
        "redact": [
          "\"id\"[[:space:]]*:[[:space:]]*\"[^\"]*\"",
          "\"(createdAt|updatedAt|timestamp)\"[[:space:]]*:[[:space:]]*\"[^\"]*\""
        ],
        "timeoutSec": 15
      }
    }
  ]
}
