{
  "$schema": "https://raw.githubusercontent.com/aryanmehrotra/ship-harness/main/schema/ship.config.schema.json",
  "tracker": { "kind": "github" },
  "testPaths": ["**/*_test.go", "test/**", "testdata/**"],
  "attribution": false,
  "caps": { "reviewA": 3, "reviewB": 2, "evidenceFix": 2 },
  "reviewers": { "correctness": "sonnet", "design": "opus" },
  "collectors": [
    { "name": "tests", "kind": "builtin:tests",
      "config": { "cmd": "go test ./...", "timeoutSec": 900 } },
    {
      "name": "api",
      "kind": "builtin:http-pairs",
      "config": {
        "baseUrl": "http://localhost:8080",
        "requests": [
          { "name": "health",        "method": "GET",  "path": "/health" },
          { "name": "list-users",    "method": "GET",  "path": "/users?limit=2" },
          { "name": "get-missing",   "method": "GET",  "path": "/users/does-not-exist" },
          { "name": "create-invalid","method": "POST", "path": "/users",
            "headers": { "Content-Type": "application/json" },
            "body": "{\"name\":\"\"}" }
        ],
        "includeHeaders": ["content-type"],
        "redact": [
          "\"id\"[[:space:]]*:[[:space:]]*\"[^\"]*\"",
          "\"(createdAt|updatedAt)\"[[:space:]]*:[[:space:]]*\"[^\"]*\"",
          "\"traceId\"[[:space:]]*:[[:space:]]*\"[^\"]*\""
        ],
        "timeoutSec": 15
      }
    }
  ]
}
